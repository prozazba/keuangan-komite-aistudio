{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Represents a student enrolled in the school, used for tracking bills and payments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique student identifier" },
        "studentId": { "type": "string", "description": "National/School Student ID (NISN)" },
        "name": { "type": "string", "description": "Student full name" },
        "classId": { "type": "string", "description": "Class identifier (e.g., Kelas 1-A)" },
        "parentsName": { "type": "string", "description": "Parents/guardians name" },
        "parentsEmail": { "type": "string", "description": "Parents email for notifications" },
        "parentsPhone": { "type": "string", "description": "Parents phone number" },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "Enrollment status" }
      },
      "required": ["id", "studentId", "name", "classId", "status"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Represents a monetary transaction (either income or expense) managed by the school committee",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction identifier" },
        "date": { "type": "string", "format": "date", "description": "Transaction date" },
        "type": { "type": "string", "enum": ["income", "expense"], "description": "Type of transaction" },
        "category": { "type": "string", "description": "Category (e.g., Iuran Bulanan, Sumbangan, Operasional, Acara)" },
        "amount": { "type": "number", "description": "Transaction amount in IDR" },
        "description": { "type": "string", "description": "Transaction details" },
        "studentId": { "type": "string", "description": "Optional associated student ID" },
        "studentName": { "type": "string", "description": "Optional associated student name" },
        "classId": { "type": "string", "description": "Optional associated student class" },
        "eventId": { "type": "string", "description": "Optional associated event ID" },
        "period": { "type": "string", "description": "Optional fee period associated (e.g., Mei 2026)" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Transfer Bank", "E-Wallet"], "description": "Method of payment" },
        "recordedBy": { "type": "string", "description": "Admin email who recorded the transaction" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "date", "type", "category", "amount", "description", "paymentMethod", "recordedBy"]
    },
    "event": {
      "title": "Event",
      "description": "Represents an event or activity planned by the committee with budgeting and actual cost tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event identifier" },
        "title": { "type": "string", "description": "Event name" },
        "description": { "type": "string", "description": "Event scope and description" },
        "date": { "type": "string", "format": "date", "description": "Event date" },
        "budgetTarget": { "type": "number", "description": "Rencana Anggaran Biaya (RAB) in IDR" },
        "actualIncome": { "type": "number", "description": "Aggregated actual income in IDR" },
        "actualExpense": { "type": "number", "description": "Aggregated actual expense in IDR" },
        "status": { "type": "string", "enum": ["planning", "active", "completed", "cancelled"], "description": "Event status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "title", "date", "budgetTarget", "status"]
    },
    "student_bill": {
      "title": "StudentBill",
      "description": "Represents a bill for school committee fee (Iuran) issued to a student for a specific period",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique bill identifier studentId_period" },
        "studentId": { "type": "string", "description": "Associated student ID" },
        "studentName": { "type": "string", "description": "Associated student name" },
        "studentClass": { "type": "string", "description": "Associated student class" },
        "period": { "type": "string", "description": "Billing period (e.g., Mei 2026)" },
        "amountRequired": { "type": "number", "description": "Billing amount in IDR" },
        "amountPaid": { "type": "number", "description": "Amount already paid towards this bill" },
        "status": { "type": "string", "enum": ["unpaid", "partially_paid", "paid"], "description": "Payment status of the bill" },
        "dueDate": { "type": "string", "format": "date", "description": "Due date" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "studentId", "studentName", "studentClass", "period", "amountRequired", "amountPaid", "status", "dueDate"]
    }
  },
  "firestore": {
    "students": {
      "schema": "student",
      "description": "School students database details"
    },
    "transactions": {
      "schema": "transaction",
      "description": "Committee income and expense transactions"
    },
    "events": {
      "schema": "event",
      "description": "Committee school activities, budgets, and actual outcomes"
    },
    "student_bills": {
      "schema": "student_bill",
      "description": "List of recurring bills and monthly school fee settings per student"
    }
  }
}
